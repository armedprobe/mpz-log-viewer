00:24:00,675 FINE  [by.softclub.mpz.sql.MpzQueryExecutor] (default task-6) executeQuery SQL=SELECT LD.*, '' MASKEDPAN, 0 SELECTED FROM  (SELECT * FROM VCLM_MAIN_ONLINE LD WHERE  LD.PERSONALNUM = (SELECT VC.PERSONALNUM FROM CLM_OL_VIEWCLAIM VC WHERE VC.IID = ?)) LD  where (LD.LOANDATASTATUS <> 6/*РђРЅРЅСѓР»РёСЂРѕРІР°РЅР°*/)
 and (LD.LOANDATASTATUS <> 5/*РСЃРїРѕР»РЅРµРЅР°*/)
 and (LD.LOANDATASTATUS <> 4/*РћС‚РєР»РѕРЅРµРЅР°*/  OR TRUNC(SYSDATE) - TRUNC(LD.AUTHORIZATIONDATE) <= 5 )
 and (LD.LOANDATASTATUS <> 3/*РЈС‚РІРµСЂР¶РґРµРЅР°*/ OR TRUNC(SYSDATE) <= TRUNC(LD.BESTBEFORE)) AND (ISMASSCREATED = 0) and (SELECT COUNT(S.SID) FROM CLM_SUBJECTS S WHERE S.LOANDATAID = LD.LOANDATAID AND NVL(S.ISACTUAL, 1) = 1) = 1   and PRODKIND <> 0  and ISCLIENTOPENCNTR > 0  ORDER BY LD.LOANDATAID DESC
