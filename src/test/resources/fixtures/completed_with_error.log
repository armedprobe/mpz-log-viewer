00:22:32,368 FINE  [by.softclub.mpz.sql.MpzQueryExecutor] (default task-23) executeQuery SQL=WITH LD AS (
  SELECT  LD.SELPLACEID, LD.BIRTHDATE, NVL(LD.GENDER,1) GENDER
  FROM    CLM_OL_LOANDATA LD
  WHERE   LD.IID = ?
),
LKO AS (
SELECT * FROM (
                  SELECT  fr.fr, R.ISNOTACTUAL, R.CONTRACTKINDDATETO, 
                          R.CONTRACTKIND STDCNTRKINDID, 
                          T.STDCNTRKINDNAME STDCNTRKINDNAME, 
                          R.MAXSUM CNTRMAXSUM,
                          R.MINSUM CNTRMINSUM,
                          R.MAXPERIOD LOANMAXTERM,
                          R.MINPERIOD LOANMINTERM,
                          R.LOAN_MAXPERIOD LOANPERIOD,
                          R.FORMULARATE PERCRATEDESC,
                          T.RATETYPE,
                          R.PERCRATE PERCRATE,
                          T.STDCNTRKINDDESC, 
                          PKGCLM_SERVICE.GETTERMUNITRETAIL(NVL(R.TYPEPERIOD, R.TRANCHE_TYPEPERIOD)) TERMUNIT,
                          T.PRODKIND, 
                          T.SORTORDER,
                          T.MALEMAXAGECET,
                          T.FEMALEMAXAGECET,
                          T.MINREPAYMENTDATE,
                          T.MAXREPAYMENTDATE,
                          T.MALED2,
                          T.FEMALED2,
                          T.MALED1,
                          T.FEMALED1,
                          T.ISFORAGENT,
                          T.ISFORCLIENT
                  FROM    (select fixrtl fr from dual) fr
                  INNER JOIN vbrs_contractkindsforposnt R ON fr.fr=fr.fr
                          INNER JOIN STDCONTRACTATTRS RP ON RP.ATTRREFID = 'RETAILPRODUCTKIND' AND RP.NVALUE = R.CONTRACTKIND 
                          INNER JOIN VCLM_LOANKINDLIST_ONLINE T ON T.STDCNTRKINDID = RP.STDCNTRKINDID 
                  ) T 
                WHERE T.PRODKIND = NVL(?, T.PRODKIND) AND NVL(T.ISNOTACTUAL, 0) = 0 AND TRUNC(NVL(T.CONTRACTKINDDATETO, SYSDATE)) >= TRUNC(SYSDATE)  AND T.ISFORCLIENT = 1 
                ORDER BY T.STDCNTRKINDNAME 
)
SELECT LKO.*, LD.*, 0 SELECTED FROM LKO, LD
WHERE  (LD.GENDER  = 1 AND LD.BIRTHDATE BETWEEN LKO.MALED1 AND LKO.MALED2
                       AND MONTHS_BETWEEN(LKO.MINREPAYMENTDATE, LD.BIRTHDATE) / 12 <= LKO.MALEMAXAGECET)
   OR  (LD.GENDER <> 1 AND LD.BIRTHDATE BETWEEN LKO.FEMALED1 AND LKO.FEMALED2
                       AND MONTHS_BETWEEN(LKO.MINREPAYMENTDATE, LD.BIRTHDATE) / 12 <= LKO.FEMALEMAXAGECET)ORDER BY LKO.SORTORDER
