00:04:19,956 FINE  [by.softclub.mpz.sql.MpzQueryExecutor] (default task-7) executeQuery SQL=SELECT  VC.LOANDATAID, S.SID, S.PERSONALNUM, L.STDCNTRKINDID, VC.AGENTID, L.SALECHANNELID, L.SALEPOINTID, S.CREDITCARDID, S.CREDITCARD4LASTNUMBER, NVL(L.ISMASSCREATED, 0) ISMASSCREATED, CA.SVALUE ADDCARDID, CL.SVALUE EXTINSURANCEID, IO.INSURANCEALGREFID,
                        COALESCE( 
                         LD.PRODKINDID,                
                         (SELECT PKND.NVALUE 
                          FROM   STDCONTRACTATTRS PKND 
                          WHERE  PKND.STDCNTRKINDID = L.STDCNTRKINDID AND PKND.ATTRREFID = 'MPZ_PRODKINDID') 
                         ) PRODKINDID, 
                         (SELECT BP.NVALUE 
                          FROM   STDCONTRACTATTRS BP 
                          WHERE  BP.STDCNTRKINDID = L.STDCNTRKINDID AND BP.ATTRREFID = 'PRODUCTID' 
                         ) BANKPRODUCTID, 
                         (SELECT NVL(CR.NVALUE, 0) ISCASCADERATE 
                          FROM   STDCONTRACTATTRS CR 
                          WHERE  CR.STDCNTRKINDID = L.STDCNTRKINDID AND CR.ATTRREFID = 'ISCASCADINGRATE' 
                         ) ISCASCADERATE, 
                        COALESCE( 
                         (SELECT SC.REGIONCODE || SC.ZONECODE || SC.PHONENUMBER PHONEMOBILE 
                          FROM   CLM_SUBJCONTACTS SC 
                          WHERE SC.SID = S.SID  AND SC.CONTACTKINDID = 3 AND SC.PHONENUMBER IS NOT NULL 
                            AND LOWER(SC.CONTACTOWNERNAME) = LOWER(S.FULLNAME) AND ROWNUM = 1), 
                         (SELECT P.REGIONCODE || P.ZONECODE || P.PHONENUMBER PHONEMOBILE 
                          FROM   CLM_OL_PHONE P 
                          WHERE  P.IID = LD.IID AND P.PHONETYPEID = 3 AND  P.PHONENUMBER IS NOT NULL), 
                         LD.PHONEMOBILE) PHONEMOBILE, 
                        COALESCE( 
                         DECODE( 
                           (SELECT SC.TELECOMOPERATOR 
                            FROM   CLM_SUBJCONTACTS SC 
                            WHERE SC.SID = S.SID  AND SC.CONTACTKINDID = 3 AND SC.PHONENUMBER IS NOT NULL 
                              AND LOWER(SC.CONTACTOWNERNAME) = LOWER(S.FULLNAME) AND ROWNUM = 1), 
                           1, 2, 2, 1, 3, 3, null), 
                         (SELECT P.TELECOMOPERATOR 
                          FROM   CLM_OL_PHONE P 
                          WHERE  P.IID = LD.IID AND P.PHONETYPEID = 3 AND  P.PHONENUMBER IS NOT NULL), 
                         LD.MOBILEOPERATORID) MOBILEOPERATORID 
                FROM CLM_OL_VIEWCLAIM VC 
                     LEFT  JOIN CLM_OL_LOANDATA LD ON LD.LOANDATAID = VC.LOANDATAID          
                     LEFT JOIN CLM_SUBJECTS S ON S.LOANDATAID = VC.LOANDATAID 
                     LEFT  JOIN CLM_SUBJATTRS CA ON CA.SID = S.SID AND CA.ATTRREFID = 'NAME_ON_CARD'                                
                     LEFT JOIN CLM_LOANDATA L ON L.LOANDATAID = S.LOANDATAID 
                     LEFT JOIN CLM_SUBJROLES SR ON SR.SID = S.SID AND SR.SUBJROLEID = 1 
                     LEFT  JOIN CLM_ATTRS CL ON CL.LOANDATAID = VC.LOANDATAID AND CL.ATTRREFID = 'EXTINSURANCECNTRID' 
                     LEFT JOIN CLM_INSURANCEORG IO ON IO.INSURANCEORGID = L.INSURANCEORGID 
WHERE VC.IID = ?
